---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { loadScripts } from '../../lib/scripts';
export function getStaticPaths() {
  return loadScripts().map((s) => ({ params: { slug: s.slug }, props: { entry: s } }));
}
const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${entry.title} · Script archive`}>
  <Nav />
  <main class="mx-auto max-w-3xl px-6 pb-32 pt-32">
    <a href={`${base}/#scripts`} class="text-xs uppercase tracking-[0.2em] opacity-60 hover:text-ember">← Script archive</a>
    <article class="prose-script mt-10" set:html={entry.html} />
  </main>
</Base>
