---
import Layout from '../layouts/Layout.astro';

const tracks = [
  { n: '01', name: 'Monologue Scripts', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/01-monologue-scripts' },
  { n: '02', name: 'Voice and Diction Log', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/02-voice-diction-log' },
  { n: '03', name: 'Audition Reel Pipeline', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/03-audition-reel-pipeline' },
  { n: '04', name: 'Character Arc Analysis', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/04-character-arc-analysis' },
  { n: '05', name: 'Audition Tracker', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/05-audition-tracker' },
  { n: '06', name: 'Body and Movement Notes', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/06-body-movement-notes' },
  { n: '07', name: 'Scene Study', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/07-scene-study' },
  { n: '08', name: 'Acting Methods Reference', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/08-acting-methods-reference' },
  { n: '09', name: 'Performance Review Log', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/09-performance-review-log' },
  { n: '10', name: 'Portfolio and Deployment', href: 'https://github.com/tjsals0106/acting-track-pipeline/tree/main/10-portfolio-deployment' },
];
---

<Layout title="Acting Portfolio">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <header class="mb-12">
      <p class="text-sm uppercase tracking-widest text-amber-400">Acting and Monologue Track</p>
      <h1 class="mt-3 text-4xl font-semibold">Portfolio</h1>
      <p class="mt-4 text-stone-300">
        Monologue work, voice and diction practice, audition reels, and performance reviews,
        kept as a daily 10-minute practice record.
      </p>
    </header>

    <section>
      <h2 class="mb-4 text-xl font-semibold">The 10 tracks</h2>
      <ul class="divide-y divide-stone-800 border-y border-stone-800">
        {tracks.map((t) => (
          <li class="flex items-center gap-4 py-3">
            <span class="w-8 font-mono text-amber-400">{t.n}</span>
            <a class="hover:text-amber-300" href={t.href} target="_blank" rel="noreferrer">{t.name}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-12">
      <h2 class="mb-4 text-xl font-semibold">Reels and media</h2>
      <p class="text-stone-400">Reel and monologue video links will be added here when they are final.</p>
    </section>

    <footer class="mt-16 text-sm text-stone-500">
      Source: <a class="underline" href="https://github.com/tjsals0106/acting-track-pipeline" target="_blank" rel="noreferrer">github.com/tjsals0106/acting-track-pipeline</a>
    </footer>
  </main>
</Layout>
