---
import { profile } from '../data/profile';
import { url } from '../lib/url';

const items = [
  { label: 'Reels', href: url('/#reels') },
  { label: 'Scripts', href: url('/scripts/') },
  { label: 'Voice', href: url('/#voice') },
  { label: 'Contact', href: url('/#contact') },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-white/5 bg-ink/70 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-6 py-4 md:px-10" aria-label="Primary">
    <a href={url('/')} class="shrink-0 font-display text-lg tracking-tight">
      {profile.name}<span class="text-brass">.</span>
    </a>
    <ul class="flex gap-4 font-mono text-[0.62rem] uppercase tracking-[0.15em] text-ash sm:gap-5 sm:text-[0.7rem] sm:tracking-[0.25em] md:gap-8">
      {items.map((i) => (
        <li><a href={i.href} class="transition-colors hover:text-bone">{i.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
