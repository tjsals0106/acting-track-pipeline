---
import { profile } from '../data/profile';
import { url } from '../lib/url';

const items = [
  { label: 'Reels', href: url('/#reels') },
  { label: 'Scripts', href: url('/scripts/') },
  { label: 'Voice', href: url('/#voice') },
  { label: 'Contact', href: url('/#contact'), wide: true },
];
---

<header class="fixed inset-x-0 top-0 z-40 border-b border-white/5 bg-ink/70 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:gap-6 sm:px-6 md:px-10" aria-label="Primary">
    <a href={url('/')} class="min-w-0 truncate font-display text-lg tracking-tight">
      {profile.name}<span class="text-brass">.</span>
    </a>
    <ul class="flex shrink-0 items-center gap-3 font-mono text-[0.62rem] uppercase tracking-[0.12em] text-ash sm:gap-5 sm:text-[0.7rem] sm:tracking-[0.25em] md:gap-8">
      {items.map((i) => (
        <li class={i.wide ? 'hidden sm:list-item' : undefined}><a href={i.href} class="transition-colors hover:text-bone">{i.label}</a></li>
      ))}
      <li>
        <button id="theme-toggle" type="button" aria-label="Toggle light or dark theme" class="-my-2 py-2 transition-colors hover:text-bone">
          <span class="hidden dark:inline">Light</span><span class="dark:hidden">Dark</span>
        </button>
      </li>
    </ul>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });
</script>
