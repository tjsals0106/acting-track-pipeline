---
interface Props { title: string; character: string; youtubeId: string; year: string }
const { title, character, youtubeId, year } = Astro.props;
const thumb = youtubeId ? `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg` : '';
---
<article class="group">
  <div class="reel relative aspect-video w-full overflow-hidden bg-black/60 ring-1 ring-current/10" data-id={youtubeId} data-title={title}>
    {youtubeId ? (
      <button type="button" class="reel-play absolute inset-0 h-full w-full" aria-label={`Play ${title}`}>
        <img src={thumb} alt="" loading="lazy" class="h-full w-full object-cover opacity-80 transition group-hover:opacity-100" />
        <span class="absolute inset-0 grid place-items-center">
          <span class="grid h-16 w-16 place-items-center rounded-full border border-white/70 text-white backdrop-blur">▶</span>
        </span>
      </button>
    ) : (
      <div class="absolute inset-0 grid place-items-center text-center text-xs uppercase tracking-[0.25em] text-white/50">
        Reel coming soon<br /><span class="mt-2 block normal-case tracking-normal opacity-70">Add a YouTube ID in src/data/profile.ts</span>
      </div>
    )}
  </div>
  <h3 class="mt-4 font-serif text-2xl">{title}</h3>
  <p class="text-xs uppercase tracking-[0.2em] opacity-60">{character} · {year}</p>
</article>
